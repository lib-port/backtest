# Local demo credentials (do not commit real secrets)
POSTGRES_USER=quant_owner
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=quantdb
QBT_API_DB_USERNAME=quant_api
QBT_API_DB_PASSWORD=replace-with-a-separate-api-password
QBT_WORKER_DB_USERNAME=quant_worker
QBT_WORKER_DB_PASSWORD=replace-with-a-separate-worker-password

# Generate a random pepper, then hash pepper + token:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# python -c "import hashlib; print(hashlib.sha256(b'REPLACE_PEPPER' + b'REPLACE_TOKEN').hexdigest())"
QBT_AUTH_MODE=api-key
QBT_API_KEY_PEPPER=REPLACE_PEPPER
QBT_API_KEYS_JSON=[{"token_sha256":"REPLACE_SHA256","actor_id":"local-user","tenant_id":"default","role":"admin"}]

QBT_API_PORT=8000
QBT_WORKER_REPLICAS=1
QBT_LOG_LEVEL=INFO
