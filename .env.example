# Local demo credentials (do not commit real secrets)
POSTGRES_USER=quant
POSTGRES_PASSWORD=replace-with-a-long-random-secret
POSTGRES_DB=quantdb

# Generate a token digest with:
# python -c "import hashlib; print(hashlib.sha256(b'REPLACE_TOKEN').hexdigest())"
QBT_AUTH_MODE=api-key
QBT_API_KEYS_JSON=[{"token_sha256":"REPLACE_SHA256","actor_id":"local-user","tenant_id":"default","role":"admin"}]

QBT_API_PORT=8000
QBT_WORKER_REPLICAS=1
QBT_LOG_LEVEL=INFO
